#!/usr/bin/env python3
"""Run a command once no Nexus conversation is running: the agent restarts its own ground with it.

  systemd-run --user --collect ~/Agents/OpenHands-Nexus/launcher/when-idle systemctl --user restart ohn-agent

A restart of ohn-agent or ohn-models ends the turn of the agent that asked for it, and of any other
conversation at work. Started detached, this waits until the agent has sent its reply and every
conversation is idle, then runs the command. Gives up after 30 minutes of work without a pause.
"""
import importlib.util
import os
import sys
import time
from pathlib import Path

WORK = Path(__file__).resolve().parent.parent
POLL = 3
IDLE_ROUNDS = 2  # the reply reaches the page a moment after the status changes
LIMIT = 30 * 60


def running_conversations():
    spec = importlib.util.spec_from_file_location("agent_config", WORK / "agent/config.py")
    config = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(config)
    try:
        items = config.call("GET", "/api/conversations/search?limit=100")["items"]
    except OSError:
        return 0  # agent-server does not answer: nothing of it can be interrupted
    return sum(item.get("execution_status") == "running" for item in items)


def wait_idle(count=running_conversations, sleep=time.sleep, clock=time.monotonic):
    deadline = clock() + LIMIT
    idle = 0
    while clock() < deadline:
        idle = idle + 1 if count() == 0 else 0
        if idle >= IDLE_ROUNDS:
            return True
        sleep(POLL)
    return False


def main(argv):
    if not argv:
        raise SystemExit("Использование: when-idle КОМАНДА [АРГУМЕНТЫ]")
    if not wait_idle():
        print("Nexus занят разговорами 30 минут подряд; команда не выполнена: " + " ".join(argv), flush=True)
        return 1
    os.execvp(argv[0], argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
