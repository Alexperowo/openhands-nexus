#!/usr/bin/env bash
# Archives of OpenHands-Nexus, in ~/Nexus-архивы (another folder: NEXUS_ARCHIVES=...).
#   ./pack                 clean archive of the last commit: the project without keys, settings,
#                          conversations, model weights or builds; checked file by file before it is kept;
#                          next to it once per engine commit: ik_llama sources, so ./install builds without GitHub
#   ./pack own             own archive of this PC: the project, the built engine, llama-swap, Caddy, voice
#                          models and the tablet certificate, ready for ./install; no conversations or session keys
#   ./pack personal        private copy of this PC: keys, tablet certificate, conversations, ~/Nexus
#   ./pack restore FILE    put a private copy back (./install does it); existing files stay untouched
# A second disk named in ~/.config/openhands-nexus/archive-copy gets the same files after each archive.
set -euo pipefail
ROOT=$(cd "$(dirname "$0")" && pwd)
OUT=${NEXUS_ARCHIVES:-$HOME/Nexus-архивы}
cd "$ROOT"

prune() {  # keep the $1 newest of the archives given, each with its .sha256; nothing else is touched
    local keep=$1 stale; shift
    [ $# -gt 0 ] && [ -e "$1" ] || return 0  # no archive: the pattern comes back as it is
    ls -1t -- "$@" | tail -n +$((keep + 1)) | while read -r stale; do
        rm -f "$stale" "$stale.sha256"
    done
}

committed() {  # both archives hold the last commit
    if ! git rev-parse --verify -q HEAD >/dev/null 2>&1; then
        echo "Архив собирается из git-копии проекта, а это распакованный архив."; exit 1
    fi
    if [ -n "$(git status --porcelain)" ]; then
        echo "Есть несохранённые в git изменения: архив должен совпадать с проектом. Сначала коммит:"
        git status --short; exit 1
    fi
}

clean() {
    committed
    local commit date name  # tmp is global: the EXIT trap runs after this function
    commit=$(git rev-parse --short HEAD)
    date=$(git log -1 --format=%cd --date=format:%Y-%m-%d)
    name="OpenHands-Nexus-linux-$date-$commit"
    mkdir -p "$OUT"
    tmp=$(mktemp "$OUT/.pack-XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    git archive --format=tar --prefix=OpenHands-Nexus/ \
        --add-virtual-file="OpenHands-Nexus/VERSION:OpenHands-Nexus linux, коммит $commit от $date"$'\n' \
        HEAD > "$tmp"
    echo "Проверка файлов архива…"
    if ! python3 -I launcher/archive.py scan "$tmp"; then
        echo "Архив не сохранён: исправьте файлы выше."; exit 1
    fi
    gzip -9 -n < "$tmp" > "$OUT/$name.tar.gz"
    (cd "$OUT" && sha256sum "$name.tar.gz" > "$name.tar.gz.sha256")
    prune 5 "$OUT"/OpenHands-Nexus-linux-*.tar.gz
    echo "Готово: $OUT/$name.tar.gz ($(du -h "$OUT/$name.tar.gz" | cut -f1))"
    engine
    mirror
    echo "Установка на чистой системе: распаковать, затем ./install (подробно: docs/first-run.md)."
}

engine() {
    local commit backend=$HOME/backend/ik_llama-fresh name  # backend: BACKEND in install
    commit=$(sed -n 's/^IK_COMMIT=//p' install)
    name="ik_llama-${commit:0:7}.bundle"
    [ ! -f "$OUT/$name" ] || return 0
    if ! git -C "$backend" cat-file -e "$commit^{commit}" 2>/dev/null; then
        echo "Исходников движка $commit нет в $backend: архив движка не собран, ./install скачает их с GitHub."
        return 0
    fi
    # One commit without history, as git clone --depth 1 would fetch; ./install marks it shallow.
    rm -f "$tmp"  # the project archive is written
    tmp=$(mktemp -d "$OUT/.pack-XXXXXX")
    git init -q --bare "$tmp/git"
    git -C "$tmp/git" fetch -q --depth 1 "file://$backend" "$commit:refs/heads/nexus"
    git -C "$tmp/git" bundle create -q "$tmp/bundle" nexus
    mv "$tmp/bundle" "$OUT/$name"
    (cd "$OUT" && sha256sum "$name" > "$name.sha256")
    prune 2 "$OUT"/ik_llama-*.bundle
    echo "Движок: $OUT/$name ($(du -h "$OUT/$name" | cut -f1)), на новой системе положить в ~/Nexus-архивы."
}

own() {
    committed
    local backend=$HOME/backend/ik_llama-fresh ik repo branch commit date name project file  # backend: BACKEND in install
    ik=$(sed -n 's/^IK_COMMIT=//p' install)
    repo=$(sed -n 's/^IK_REPO=//p' install)
    branch=$(git branch --show-current)
    project=${ROOT#"$HOME"/}
    [ "$project" != "$ROOT" ] || { echo "Проект не в домашней папке: архив этого ПК не собран."; exit 1; }
    [ -n "$branch" ] || { echo "Проект не на ветке (git switch linux): архив не собран."; exit 1; }
    if [ "$(git -C "$backend" rev-parse HEAD 2>/dev/null)" != "$ik" ] ||
        [ -n "$(git -C "$backend" status --porcelain --untracked-files=no)" ]; then
        echo "Движок в $backend не на коммите ${ik:0:7} из install или изменён: архив не собран."; exit 1
    fi
    commit=$(git rev-parse --short HEAD)
    date=$(git log -1 --format=%cd --date=format:%Y-%m-%d)
    name="nexus-own-$date-$commit.tar.zst"
    mkdir -p "$OUT/личное" && chmod 700 "$OUT/личное"
    tmp=$(mktemp -d "$OUT/личное/.pack-XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    local p="$tmp/home/$project" e="$tmp/home/backend/ik_llama-fresh"
    # Fresh clones without hooks, logs or history: the last commit of each, origin as before.
    git clone -q --template= --depth 1 --no-tags --branch "$branch" "file://$ROOT" "$p"
    git -C "$p" remote set-url origin "$(git remote get-url origin)"
    git init -q --template= "$e"
    git -C "$e" fetch -q --depth 1 --no-tags "file://$backend" "$ik"
    git -C "$e" checkout -q --detach "$ik"
    git -C "$e" remote add origin "$repo"
    rm -rf "$p/.git/logs" "$e/.git/logs" "$e/.git/FETCH_HEAD"
    # What ./install would build or download, as it is on this PC.
    cp -p models/llama-swap "$p/models/"
    cp -p gateway/caddy "$p/gateway/"
    mkdir -m 700 "$p/gateway/ca"
    cp -p gateway/ca/openhands-ca.crt gateway/ca/openhands-ca.key "$p/gateway/ca/"
    cp -rp voice/models "$p/voice/"
    cp -P models/llama-server models/weights "$p/models/"
    for file in bin/llama-server src/libllama.so ggml/src/libggml.so examples/mtmd/libmtmd.so CMakeCache.txt; do
        mkdir -p "$e/build/$(dirname "$file")"
        cp -p "$backend/build/$file" "$e/build/$file"
    done
    echo "Проверка файлов архива…"
    tar -C "$tmp/home" --sort=name -cf "$tmp/own.tar" "$project" backend/ik_llama-fresh
    if ! python3 -I launcher/archive.py scan-own "$tmp/own.tar"; then
        echo "Архив не сохранён: исправьте файлы выше."; exit 1
    fi
    echo "Сжатие…"
    zstd -q -T0 -12 "$tmp/own.tar" -o "$tmp/$name"
    chmod 600 "$tmp/$name"  # zstd gives the archive the mode of the tar
    mv "$tmp/$name" "$OUT/личное/$name"
    (cd "$OUT/личное" && sha256sum "$name" > "$name.sha256")
    prune 2 "$OUT"/личное/nexus-own-*.tar.zst
    echo "Готово: $OUT/личное/$name ($(du -h "$OUT/личное/$name" | cut -f1))."
    echo "В нём сертификат планшета: хранить у себя, никому не отправлять."
    mirror
}

mirror() {
    local copy file
    copy=$(cat "$HOME/.config/openhands-nexus/archive-copy" 2>/dev/null) || return 0
    if ! mkdir -p "$copy/личное" 2>/dev/null || ! chmod 700 "$copy/личное"; then
        echo "Второй диск недоступен ($copy): копия архивов не сделана."; return 0
    fi
    shopt -s nullglob
    for file in "$OUT"/* "$OUT"/личное/*; do
        if [ -f "$file" ]; then cp -pu "$file" "$copy/${file#"$OUT"/}"; fi
    done
    shopt -u nullglob
    # As many as in $OUT (личное: archive.py backup keeps three); other files on the disk stay.
    prune 5 "$copy"/OpenHands-Nexus-linux-*.tar.gz
    prune 2 "$copy"/ik_llama-*.bundle
    prune 3 "$copy"/личное/nexus-personal-*.tar.gz
    prune 2 "$copy"/личное/nexus-own-*.tar.zst
    echo "Копия на втором диске: $copy"
}

case "${1:-}" in
    "") clean ;;
    own) own ;;
    personal)
        if systemctl --user is-active --quiet ohn-agent 2>/dev/null; then
            echo "Агент запущен: беседа, идущая сейчас, может попасть в копию не целиком."
        fi
        python3 -I launcher/archive.py backup "$OUT/личное"
        mirror ;;
    restore)
        [ -n "${2:-}" ] || { echo "Укажите файл: ./pack restore ФАЙЛ"; exit 2; }
        python3 -I launcher/archive.py restore "$2" ;;
    *) sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
